DATABASE_URL=postgresql://onb:onb@localhost:5433/onb

# Model servers (llama.cpp), reached over an SSH tunnel to the inference host.
# See README: "Model servers".
LLAMA_URL=http://localhost:8090
LLAMA_MODEL=qwen3-14b-claude-opus-distill-q4km
LLAMA_API_KEY=
LLAMA_TIMEOUT=300
LLAMA_MAX_TOKENS=1500

EMBED_URL=http://localhost:8091
EMBED_MODEL=bge-m3
EMBED_DIM=1024

RERANK_URL=http://localhost:8092
RERANK_MODEL=bge-reranker-v2-m3

# chunking
CHUNK_TOKENS=500
CHUNK_OVERLAP=0.15

# gate
MIN_ANSWERABLE_CONFIDENCE=0.7
